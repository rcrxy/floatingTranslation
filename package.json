{
   "name": "floating-translation",
   "displayName": "Floating Translation",
   "description": "Translate VS Code hover documentation through configurable translation services.",
   "version": "0.0.2",
   "publisher": "zeco",
   "icon": "resources/ft_logo.png",
   "license": "SEE LICENSE IN LICENSE",
   "repository": {
      "type": "git",
      "url": "https://github.com/rcrxy/floatingTranslation.git"
   },
   "engines": {
      "vscode": "^1.125.0"
   },
   "categories": [
      "Other"
   ],
   "activationEvents": [
      "onStartupFinished"
   ],
   "main": "./dist/extension.js",
   "contributes": {
      "commands": [
         {
            "command": "floatingTranslation.trigger",
            "title": "Floating Translation: trigger"
         },
         {
            "command": "floatingTranslation.configureCredentials",
            "title": "Floating Translation: Configure Credentials"
         },
         {
            "command": "floatingTranslation.clearCredentials",
            "title": "Floating Translation: Clear Credentials"
         }
      ],
      "keybindings": [
         {
            "command": "floatingTranslation.trigger",
            "key": "ctrl+alt+t"
         }
      ],
      "configuration": {
         "title": "Floating Translation",
         "properties": {
             "floating-translation.sourceLanguage": {
               "type": "string",
               "default": "auto",
               "scope": "application",
               "description": "待翻译文本的原语言代码。",
               "order": 0
            },
            "floating-translation.targetLanguage": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "译文的目标语言代码。留空时使用 VS Code 当前的显示语言。",
               "order": 1
            },
            "floating-translation.translationTool": {
               "type": "string",
               "enum": [
                  "aliyun",
                  "baidu",
                  "openaiCompatible"
               ],
               "enumItemLabels": [
                  "阿里云",
                  "百度翻译",
                  "OpenAI 兼容服务"
               ],
               "default": "aliyun",
               "scope": "application",
               "description": "当前使用的翻译平台。",
               "order": 2
            },
            "floating-translation.translationMode": {
               "type": "string",
               "enum": [
                  "fullText",
                  "codeBlocks",
                  "remotePlaceholders",
                  "localPlaceholders"
               ],
               "enumItemLabels": [
                  "全文直译",
                  "代码块保护",
                  "占位符保护（平台回传）",
                  "占位符保护（本地隔离）"
               ],
               "enumDescriptions": [
                  "将完整 Hover Markdown 发送给翻译服务，不保护代码或格式。",
                  "保留围栏代码块和缩进代码，其余原始 Markdown 发送给翻译服务。",
                  "将占位符随正文发送给翻译服务，保留句子上下文，但部分平台可能修改占位符。",
                  "占位符仅保留在本地，只发送占位符之间的自然语言，保护最可靠但会减少上下文，降低翻译准确性。"
               ],
               "default": "codeBlocks",
               "scope": "application",
               "description": "控制发送给翻译服务的内容范围和受保护内容的处理方式。",
               "order": 3
            },
            "floating-translation.credentialStorage": {
               "type": "string",
               "enum": [
                  "settings",
                  "secretStorage"
               ],
               "enumItemLabels": [
                  "明文设置",
                  "加密存储"
               ],
               "default": "settings",
               "scope": "application",
               "markdownDescription": "各翻译平台凭据的读写方式。选择加密存储后，请先选择翻译平台，再执行 `Floating Translation: Configure Credentials` 写入该平台凭据。",
               "order": 4
            },
            "floating-translation.aliyunAccessKeyId": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "阿里云 AccessKey ID。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 6
            },
            "floating-translation.aliyunAccessKeySecret": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "阿里云 AccessKey Secret。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 6
            },
            "floating-translation.baiduAppId": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "百度翻译开放平台 APPID。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 6
            },
            "floating-translation.baiduAppKey": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "百度翻译开放平台密钥。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 6
            },
            "floating-translation.openAiCompatibleEndpoint": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "OpenAI 兼容服务的完整 Chat Completions 请求地址。扩展不会自动拼接路径；Hover 文本会发送到该地址。仅支持 HTTP 或 HTTPS。",
               "order": 6
            },
            "floating-translation.openAiCompatibleApiKey": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "OpenAI 兼容服务的 API Key。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 6
            },
            "floating-translation.openAiCompatibleModel": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "OpenAI 兼容服务提供的模型标识符。必须按目标服务的实际模型列表填写。",
               "order": 6
            },
            "floating-translation.customPrompt": {
               "type": "string",
               "default": "",
               "scope": "application",
               "description": "OpenAI 兼容翻译使用的附加偏好，不能覆盖扩展内置的输出与结构保护约束。",
               "order": 999
            }
         }
      }
   },
   "scripts": {
      "vscode:prepublish": "npm run package",
      "compile": "webpack",
      "watch": "webpack --watch",
      "package": "webpack --mode production --devtool hidden-source-map",
      "compile-tests": "tsc -p . --outDir out",
      "watch-tests": "tsc -p . -w --outDir out",
      "pretest": "npm run compile-tests && npm run compile && npm run lint",
      "lint": "eslint src",
      "format": "prettier . --write",
      "format:check": "prettier . --check",
      "test": "vscode-test"
   },
   "devDependencies": {
      "@types/mocha": "^10.0.10",
      "@types/node": "^26.1.2",
      "@types/vscode": "^1.125.0",
      "@types/ws": "^8.18.1",
      "@vscode/test-cli": "^0.0.15",
      "@vscode/test-electron": "^3.0.0",
      "eslint": "^10.5.0",
      "eslint-config-prettier": "^10.1.8",
      "prettier": "^3.9.6",
      "ts-loader": "^9.6.2",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.61.1",
      "webpack": "^5.107.2",
      "webpack-cli": "^7.0.3"
   },
   "overrides": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.0.6"
   },
   "dependencies": {
      "@alicloud/alimt20181012": "^1.4.2"
   }
}
