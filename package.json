{
   "name": "floating-translation",
   "displayName": "%extension.displayName%",
   "description": "%extension.description%",
   "version": "0.0.7",
   "publisher": "zeco",
   "icon": "resources/ft_logo.png",
   "license": "SEE LICENSE IN LICENSE",
   "repository": {
      "type": "git",
      "url": "https://github.com/rcrxy/floatingTranslation.git"
   },
   "engines": {
      "vscode": "^1.125.0"
   },
   "categories": [
      "Other"
   ],
   "activationEvents": [
      "onStartupFinished"
   ],
   "main": "./dist/extension.js",
   "l10n": "./l10n",
   "contributes": {
      "commands": [
         {
            "command": "floatingTranslation.trigger",
            "title": "%command.trigger.title%"
         },
         {
            "command": "floatingTranslation.configureCredentials",
            "title": "%command.configureCredentials.title%"
         },
         {
            "command": "floatingTranslation.clearCredentials",
            "title": "%command.clearCredentials.title%"
         }
      ],
      "keybindings": [
         {
            "command": "floatingTranslation.trigger",
            "key": "ctrl+alt+t"
         }
      ],
      "configuration": {
         "title": "%configuration.title%",
         "properties": {
            "floating-translation.sourceLanguage": {
               "type": "string",
               "default": "auto",
               "scope": "application",
               "description": "%configuration.sourceLanguage.description%",
               "order": 0
            },
            "floating-translation.targetLanguage": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "%configuration.targetLanguage.description%",
               "order": 1
            },
            "floating-translation.translationTool": {
               "type": "string",
               "enum": [
                  "aliyun",
                  "baidu",
                  "openaiCompatible"
               ],
               "enumItemLabels": [
                  "%configuration.translationTool.aliyun%",
                  "%configuration.translationTool.baidu%",
                  "%configuration.translationTool.openAiCompatible%"
               ],
               "default": "aliyun",
               "scope": "application",
               "description": "%configuration.translationTool.description%",
               "order": 2
            },
            "floating-translation.translationMode": {
               "type": "string",
               "enum": [
                  "fullText",
                  "codeBlocks",
                  "remotePlaceholders",
                  "localPlaceholders"
               ],
               "enumItemLabels": [
                  "%configuration.translationMode.fullText%",
                  "%configuration.translationMode.codeBlocks%",
                  "%configuration.translationMode.remotePlaceholders%",
                  "%configuration.translationMode.localPlaceholders%"
               ],
               "enumDescriptions": [
                  "%configuration.translationMode.fullText.description%",
                  "%configuration.translationMode.codeBlocks.description%",
                  "%configuration.translationMode.remotePlaceholders.description%",
                  "%configuration.translationMode.localPlaceholders.description%"
               ],
               "default": "codeBlocks",
               "scope": "application",
               "description": "%configuration.translationMode.description%",
               "order": 3
            },
            "floating-translation.maxCacheCount": {
               "type": "integer",
               "minimum": 1,
               "default": 300,
               "scope": "window",
               "description": "%configuration.maxCacheCount.description%",
               "order": 5
            },
            "floating-translation.credentialStorage": {
               "type": "string",
               "enum": [
                  "settings",
                  "secretStorage"
               ],
               "enumItemLabels": [
                  "%configuration.credentialStorage.settings%",
                  "%configuration.credentialStorage.secretStorage%"
               ],
               "default": "settings",
               "scope": "application",
               "markdownDescription": "%configuration.credentialStorage.description%",
               "order": 4
            },
            "floating-translation.generalPlatformCredentials": {
               "type": "object",
               "default": {
                  "QPS": 50,
                  "aliyunAccessKeyId": "",
                  "aliyunAccessKeySecret": "",
                  "baiduAppId": "",
                  "baiduAppKey": ""
               },
               "properties": {
                  "QPS": {
                     "type": "integer",
                     "minimum": 1,
                     "default": 50,
                     "markdownDescription": "%configuration.generalPlatformCredentials.qps.description%"
                  },
                  "aliyunAccessKeyId": {
                     "type": "string"
                  },
                  "aliyunAccessKeySecret": {
                     "type": "string"
                  },
                  "baiduAppId": {
                     "type": "string"
                  },
                  "baiduAppKey": {
                     "type": "string"
                  }
               },
               "additionalProperties": false,
               "scope": "application",
               "markdownDescription": "%configuration.generalPlatformCredentials.description%",
               "order": 6
            },
            "floating-translation.openAiCompatibleConfiguration": {
               "type": "object",
               "default": {
                  "openAiCompatibleEndpoint": "",
                  "openAiCompatibleApiKey": "",
                  "openAiCompatibleModel": "",
                  "customPrompt": ""
               },
               "properties": {
                  "openAiCompatibleEndpoint": {
                     "type": "string"
                  },
                  "openAiCompatibleApiKey": {
                     "type": "string"
                  },
                  "openAiCompatibleModel": {
                     "type": "string"
                  },
                  "customPrompt": {
                     "type": "string"
                  }
               },
               "additionalProperties": false,
               "scope": "application",
               "markdownDescription": "%configuration.openAiCompatibleConfiguration.description%",
               "order": 6
            }
         }
      }
   },
   "scripts": {
      "vscode:prepublish": "npm run package",
      "compile": "webpack",
      "watch": "webpack --watch",
      "package": "webpack --mode production --devtool hidden-source-map",
      "compile-tests": "tsc -p . --outDir out",
      "watch-tests": "tsc -p . -w --outDir out",
      "pretest": "npm run compile-tests && npm run compile && npm run lint",
      "lint": "eslint src",
      "format": "prettier . --write",
      "format:check": "prettier . --check",
      "test": "vscode-test"
   },
   "devDependencies": {
      "@types/mocha": "^10.0.10",
      "@types/node": "^26.1.2",
      "@types/vscode": "^1.125.0",
      "@types/ws": "^8.18.1",
      "@vscode/test-cli": "^0.0.15",
      "@vscode/test-electron": "^3.0.0",
      "eslint": "^10.5.0",
      "eslint-config-prettier": "^10.1.8",
      "prettier": "^3.9.6",
      "ts-loader": "^9.6.2",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.61.1",
      "webpack": "^5.107.2",
      "webpack-cli": "^7.0.3"
   },
   "overrides": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.0.6"
   },
   "dependencies": {
      "@alicloud/alimt20181012": "^1.4.2"
   }
}
