{
   "name": "floating-translation",
   "displayName": "Floating Translation",
   "description": "Translate VS Code hover documentation through configurable translation services.",
   "version": "0.0.1",
   "publisher": "zeco",
   "license": "SEE LICENSE IN LICENSE",
   "engines": {
      "vscode": "^1.125.0"
   },
   "categories": [
      "Other"
   ],
   "activationEvents": [
      "onStartupFinished"
   ],
   "main": "./dist/extension.js",
   "contributes": {
      "commands": [
         {
            "command": "floatingTranslation.trigger",
            "title": "Floating Translation: trigger"
         },
         {
            "command": "floatingTranslation.configureCredentials",
            "title": "Floating Translation: Configure Credentials"
         },
         {
            "command": "floatingTranslation.clearCredentials",
            "title": "Floating Translation: Clear Credentials"
         }
      ],
      "keybindings": [
         {
            "command": "floatingTranslation.trigger",
            "key": "ctrl+alt+t"
         }
      ],
      "configuration": {
         "title": "Floating Translation",
         "properties": {
            "floating-translation.translationTool": {
               "type": "string",
               "enum": [
                  "aliyun",
                  "baidu"
               ],
               "enumItemLabels": [
                  "阿里云",
                  "百度翻译"
               ],
               "default": "aliyun",
               "scope": "application",
               "description": "当前使用的翻译平台。",
               "order": 0
            },
            "floating-translation.credentialStorage": {
               "type": "string",
               "enum": [
                  "settings",
                  "secretStorage"
               ],
               "enumItemLabels": [
                  "明文设置",
                  "加密存储"
               ],
               "default": "settings",
               "scope": "application",
               "markdownDescription": "API Key 和 Secret Key 的读写方式。选择加密存储后，请执行 `Floating Translation: Configure Credentials` 写入凭据。",
               "order": 1
            },
            "floating-translation.apiKey": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "翻译平台的公开标识。阿里云使用 AccessKey ID，百度翻译使用 APPID。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 2
            },
            "floating-translation.secretKey": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "翻译平台的私密凭据。阿里云使用 AccessKey Secret，百度翻译使用密钥。仅在凭据存储方式为明文设置时读取。该值会以普通 VS Code 设置存储，请勿提交到版本控制。",
               "order": 3
            },
            "floating-translation.sourceLanguage": {
               "type": "string",
               "default": "auto",
               "scope": "application",
               "description": "待翻译文本的原语言代码。",
               "order": 4
            },
            "floating-translation.targetLanguage": {
               "type": "string",
               "default": "",
               "scope": "application",
               "markdownDescription": "译文的目标语言代码。留空时使用 VS Code 当前的显示语言。",
               "order": 5
            },
            "floating-translation.customPrompt": {
               "type": "string",
               "default": "",
               "scope": "application",
               "description": "未来接入 AI 翻译平台时使用的自定义提示词。",
               "order": 999
            }
         }
      }
   },
   "scripts": {
      "vscode:prepublish": "npm run package",
      "compile": "webpack",
      "watch": "webpack --watch",
      "package": "webpack --mode production --devtool hidden-source-map",
      "compile-tests": "tsc -p . --outDir out",
      "watch-tests": "tsc -p . -w --outDir out",
      "pretest": "npm run compile-tests && npm run compile && npm run lint",
      "lint": "eslint src",
      "format": "prettier . --write",
      "format:check": "prettier . --check",
      "test": "vscode-test"
   },
   "devDependencies": {
      "@types/mocha": "^10.0.10",
      "@types/node": "^26.1.2",
      "@types/vscode": "^1.125.0",
      "@types/ws": "^8.18.1",
      "@vscode/test-cli": "^0.0.15",
      "@vscode/test-electron": "^3.0.0",
      "eslint": "^10.5.0",
      "eslint-config-prettier": "^10.1.8",
      "prettier": "^3.9.6",
      "ts-loader": "^9.6.2",
      "typescript": "^6.0.3",
      "typescript-eslint": "^8.61.1",
      "webpack": "^5.107.2",
      "webpack-cli": "^7.0.3"
   },
   "overrides": {
      "diff": "^8.0.4",
      "serialize-javascript": "^7.0.6"
   },
   "dependencies": {
      "@alicloud/alimt20181012": "^1.4.2"
   }
}
